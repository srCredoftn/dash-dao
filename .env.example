# SMTP (primary)
SMTP_HOST=smtp.example.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=your_smtp_user
SMTP_PASS=your_smtp_password
SMTP_FROM=no-reply@example.com
SMTP_REPLY_TO=no-reply@example.com

# Optional: SendGrid SMTP (fallback) — provide your SendGrid API key as password
SENDGRID_SMTP_HOST=smtp.sendgrid.net
SENDGRID_SMTP_PORT=587
SENDGRID_SMTP_SECURE=false
SENDGRID_SMTP_USER=apikey
SENDGRID_SMTP_PASS=SG.xxxxx

# Centralized testing/monitoring address — if enabled (SMTP_FORCE_TO_CENTRAL=true) all outgoing mail is forced to this address
SMTP_CENTRAL_ADDRESS=monitor@example.com
SMTP_FORCE_TO_CENTRAL=false

# Behavior flags
SMTP_DISABLE=false        # true to disable actual SMTP sends
SMTP_DRY_RUN=false        # true to simulate sends in non-prod
EMAIL_BROADCAST_ALL=false # if true, notifications that target specific users will broadcast to all users

# Critical DAO thresholds
CRITICAL_DAYS_THRESHOLD=7          # days before dateDepot considered critical
CRITICAL_PROGRESS_THRESHOLD=20     # progress % below which DAO is considered critical
CRITICAL_SEND_MODE=team            # 'team' | 'all' | 'central' — where to send critical alerts

# Periodic reminder settings
CRITICAL_REMINDER_ENABLED=true
CRITICAL_REMINDER_INTERVAL_MS=86400000   # how often the background job runs (default 24h)
CRITICAL_REMINDER_REPEAT_MS=86400000     # minimum time between reminders for the same DAO (default 24h)

# Queue & retry tuning (optional)
SMTP_BATCH_SIZE=25
SMTP_BATCH_DELAY_MS=150
SMTP_MAX_RETRY=3
SMTP_RETRY_DELAY_MS=2000

# Admin contact (fallback recipient for system notices)
ADMIN_EMAIL=admin@example.com

# Other runtime
NODE_ENV=development
BACKEND_PORT=3001
